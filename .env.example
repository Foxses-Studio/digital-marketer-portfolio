# PostgreSQL connection string
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Signs admin session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL (used for canonical and Open Graph URLs until set in admin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used once by `npm run admin:create`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
