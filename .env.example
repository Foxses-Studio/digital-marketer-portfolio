# ---------------------------------------------------------------- Database
# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers).
# Server-only secret: never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Database name inside the cluster
MONGODB_DB=portfolio

# ------------------------------------------------------------------- Media
# Storage driver for uploads. Only "local" is implemented so far (files are
# written to MEDIA_LOCAL_DIR and served from /media/...). Use a cloud driver
# (S3/R2/Cloudinary, added later) on serverless hosting.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=storage/uploads
MEDIA_MAX_UPLOAD_MB=10

# -------------------------------------------------------------------- Site
# Public base URL (used for canonical and Open Graph URLs until set in admin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------- Account recovery (optional)
# Only read by `npm run admin:recover`. Leave empty otherwise.
ADMIN_EMAIL=
ADMIN_PASSWORD=
